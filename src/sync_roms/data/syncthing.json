{
  "note": "Settings that let Syncthing sync RetroArch saves and states between devices: one libretro core per system on every device (so RetroArch's core-named save folders match), RetroArch's save settings, and per-firmware settings. Spruce cards get them from sync; Android gets them from `config apply`. N64, Saturn, Dreamcast and Jaguar keep each device's own core and don't sync between Spruce and Android.",
  "cores": {"arduboy": "ardens", "atarilynx": "handy", "colecovision": "bluemsx", "fbneo": "fbneo", "fds": "fceumm",
            "gamegear": "genesis_plus_gx", "gb": "gambatte", "gba": "mgba", "gbc": "gambatte", "genesis": "genesis_plus_gx",
            "mastersystem": "genesis_plus_gx", "msx": "bluemsx", "msx2": "bluemsx", "nes": "fceumm", "ngp": "mednafen_ngp",
            "ngpc": "mednafen_ngp", "psx": "pcsx_rearmed", "segacd": "genesis_plus_gx", "sg1000": "genesis_plus_gx",
            "snes": "snes9x"},
  "esde_labels": {"ardens": "Ardens", "handy": "Handy", "bluemsx": "blueMSX", "fbneo": "FinalBurn Neo", "fceumm": "FCEUmm",
                  "genesis_plus_gx": "Genesis Plus GX", "gambatte": "Gambatte", "mgba": "mGBA", "mednafen_ngp": "Beetle NeoPop",
                  "pcsx_rearmed": "PCSX ReARMed", "snes9x": "Snes9x - Current"},
  "retroarch": {"autosave_interval": "10", "sort_savefiles_enable": "true", "sort_savestates_enable": "true",
                "sort_savefiles_by_content_enable": "false", "sort_savestates_by_content_enable": "false",
                "savefiles_in_content_dir": "false", "savestates_in_content_dir": "false"},
  "folder": {"ignore_permissions": true, "max_conflicts": 0, "versioning": {"type": "simple", "keep": 5}},
  "spruce": {"settings": {"Emulator Settings": {"raAutoSave": "True", "raAutoLoad": "True", "keepSavesBetweenCores": "Always"},
                          "Network Settings": {"enableSyncthing": "True"}},
            "folders": {"saves": {"path": "Saves/saves", "label": "RetroArch saves"},
                        "states": {"path": "Saves/states", "label": "RetroArch states"}}}
